{
  "name": "legal-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "description": "Next-Generation Legal Intelligence & Contract Risk Auditing Platform",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend run test",
    "test": "npm run test:backend",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "migrate": "npm --prefix backend run migrate"
  },
  "keywords": [
    "legal-ai",
    "contract-audit",
    "pgvector",
    "bullmq"
  ],
  "author": "Legal Intelligence Platform Team",
  "license": "MIT"
}
