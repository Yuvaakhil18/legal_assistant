# Backend Local Environment Variables
PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_intel
REDIS_URL=redis://localhost:6379
USE_IN_MEMORY_FALLBACK=true

GEMINI_API_KEY=your_gemini_api_key_here
MODEL_REASONING=gemini-3.8-flash
MODEL_REASONING_FALLBACK=gemini-3.5-flash
MODEL_EMBEDDING=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

SIMILARITY_THRESHOLD_HIGH_RISK=0.72
SIMILARITY_THRESHOLD_DEFAULT=0.65
RETRIEVAL_TOP_K=3

MAX_FILE_SIZE_MB=5
RATE_LIMIT_RPM=60
ANALYSIS_WORKER_CONCURRENCY=4
ANALYSIS_JOB_MAX_RETRIES=3
