# =============================================================================
# Legal Intelligence Platform - Environment Configuration Template
# Architecture V2 Specification
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# Database Infrastructure (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_intel
POSTGRES_PORT=5433

# Cache & Job Queue (Redis 7 + BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Resilient Development Fallback (Enables in-memory mocks when DB or Redis are offline)
USE_IN_MEMORY_FALLBACK=true

# AI / Google Gemini Engine Configuration
# Replace with your actual API key for live analysis
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_REASONING=gemini-3.8-flash
MODEL_REASONING_FALLBACK=gemini-3.5-flash
MODEL_EMBEDDING=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Configurable Retrieval & Scoring Thresholds
SIMILARITY_THRESHOLD_HIGH_RISK=0.72
SIMILARITY_THRESHOLD_DEFAULT=0.65
RETRIEVAL_TOP_K=3

# Processing Boundaries & Rate Limits
MAX_FILE_SIZE_MB=5
RATE_LIMIT_RPM=60
ANALYSIS_WORKER_CONCURRENCY=4
ANALYSIS_JOB_MAX_RETRIES=3
